{
  "$schema": "https://biomejs.dev/schemas/2.1.2/schema.json",
  "extends": ["ultracite"],
  "linter": {
    "rules": {
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "performance": {
        "noNamespaceImport": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  }
}
