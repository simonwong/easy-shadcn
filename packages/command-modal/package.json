{
  "name": "@easy-shadcn/command-modal",
  "version": "0.2.0",
  "description": "use modal by command",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./es/index.js",
  "types": "./es/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "import": {
        "types": "./es/index.d.ts",
        "default": "./es/index.js"
      }
    },
    "./antd": {
      "require": {
        "types": "./lib/antd.d.ts",
        "default": "./lib/antd.js"
      },
      "import": {
        "types": "./es/antd.d.ts",
        "default": "./es/antd.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "lib",
    "es"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest --run --typecheck.only",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "Simon <wsj_simon@163.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.20.1",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
